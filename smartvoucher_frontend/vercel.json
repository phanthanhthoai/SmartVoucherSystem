{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://smartvoucher-api.mango-demo.cloud/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://smartvoucher-api.mango-demo.cloud/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://smartvoucher-api.mango-demo.cloud/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}