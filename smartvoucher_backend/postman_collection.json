            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"external_order_id\", \"POSTMAN-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.order_id) pm.environment.set(\"order_id\", String(data.order_id));",
                  "  if (data.external_order_id) pm.environment.set(\"external_order_id\", data.external_order_id);",
                  "}"
                ]
              }
            }
          ]
        },
