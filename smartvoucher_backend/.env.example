# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=smartvoucher
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=db
DB_PORT=3306

# Shared Redis cache (Docker Compose overrides the host to its redis service)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1
CACHE_TIMEOUT=300

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Required only when bootstrapping the first admin account.
SMARTVOUCHER_ADMIN_USERNAME=
SMARTVOUCHER_ADMIN_EMAIL=
SMARTVOUCHER_ADMIN_PASSWORD=

# Test catalog fixture: checkout sends product_id and quantity only.
# Replace with a trusted product-catalog integration for production.
PRODUCT_CATALOG_JSON={"1":{"name":"Kẹo Dẻo 123","product_type":"candy","unit_price":"25000"},"2":{"name":"Trà Sữa 123","product_type":"drink","unit_price":"45000"},"3":{"name":"Sô-cô-la 123","product_type":"candy","unit_price":"65000"},"4":{"name":"Nước Tăng 123","product_type":"drink","unit_price":"30000"},"5":{"name":"Kẹo Nổ 123","product_type":"candy","unit_price":"15000"},"6":{"name":"Sinh Tố 123","product_type":"drink","unit_price":"55000"},"7":{"name":"Kẹo Dẻo ABC","product_type":"candy","unit_price":"25000"},"8":{"name":"Trà Sữa ABC","product_type":"drink","unit_price":"45000"},"9":{"name":"Sô-cô-la ABC","product_type":"candy","unit_price":"65000"},"10":{"name":"Nước Tăng ABC","product_type":"drink","unit_price":"30000"},"11":{"name":"Kẹo Nổ ABC","product_type":"candy","unit_price":"15000"},"12":{"name":"Sinh Tố ABC","product_type":"drink","unit_price":"55000"}}
